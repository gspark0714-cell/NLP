pip install nltk

from nltk.translate.bleu_score import sentence_bleu, corpus_bleu, SmoothingFunction

# ── 1. 단일 문장 BLEU ──────────────────────────────────────────

# 정답 번역 (2차원 리스트: 정답이 여러 개일 수 있어서 리스트로 감쌈)
reference = [["나는", "오늘", "학교에서", "밥을", "먹었다"]]

# 기계 번역 후보
candidate_good = ["나는", "오늘", "학교에서", "밥을", "먹었다"]   # 완벽
candidate_mid  = ["나는", "오늘", "식당에서", "밥을", "먹었다"]   # 한 단어 다름
candidate_bad  = ["나는", "어제", "집에서", "라면을", "끓였다"]   # 많이 다름

smoothie = SmoothingFunction().method1  # 짧은 문장 0점 방지용

print("=== 단일 문장 BLEU ===")
print(f"완벽한 번역 : {sentence_bleu(reference, candidate_good, smoothing_function=smoothie):.4f}")
print(f"비슷한 번역 : {sentence_bleu(reference, candidate_mid,  smoothing_function=smoothie):.4f}")
print(f"나쁜 번역   : {sentence_bleu(reference, candidate_bad,  smoothing_function=smoothie):.4f}")


# ── 2. 정답이 여러 개인 경우 ────────────────────────────────────

# "I love you"를 번역한 예시 — 정답이 3가지
multi_reference = [
    ["나는", "너를", "사랑해"],
    ["나는", "당신을", "사랑합니다"],
    ["사랑해"],
]

candidate_a = ["나는", "너를", "사랑해"]       # 정답 1과 완전히 일치
candidate_b = ["나는", "당신을", "사랑해"]     # 두 정답의 혼합
candidate_c = ["나는", "너를", "좋아해"]       # 의미는 비슷하지만 단어 다름

print("\n=== 정답 여러 개 BLEU ===")
print(f"정답과 일치  : {sentence_bleu(multi_reference, candidate_a, smoothing_function=smoothie):.4f}")
print(f"혼합 표현    : {sentence_bleu(multi_reference, candidate_b, smoothing_function=smoothie):.4f}")
print(f"유사 표현    : {sentence_bleu(multi_reference, candidate_c, smoothing_function=smoothie):.4f}")


# ── 3. 코퍼스 BLEU (문장 여러 개를 한꺼번에 평가) ──────────────

# 실제 모델 평가에서는 문장 한 개가 아니라 전체 데이터셋으로 평가함
references_corpus = [
    [["나는", "학교에", "갔다"]],
    [["고양이가", "생선을", "먹었다"]],
    [["오늘", "날씨가", "매우", "맑다"]],
]

candidates_corpus = [
    ["나는", "학교에", "갔다"],          # 완벽
    ["고양이가", "밥을", "먹었다"],      # 한 단어 다름
    ["오늘", "날씨가", "좋다"],          # 한 단어 다름
]

score = corpus_bleu(references_corpus, candidates_corpus)
print(f"\n=== 코퍼스 BLEU ===")
print(f"전체 데이터셋 BLEU : {score:.4f}")


# ── 4. n-gram별 가중치 직접 지정 ────────────────────────────────

# 기본은 1-gram~4-gram 동일 가중치 (0.25씩)
# 1-gram만 보고 싶다면:
w1 = sentence_bleu(reference, candidate_mid, weights=(1, 0, 0, 0))
# 1-gram + 2-gram만 보고 싶다면:
w2 = sentence_bleu(reference, candidate_mid, weights=(0.5, 0.5, 0, 0))
# 기본 (1~4-gram 균등):
w4 = sentence_bleu(reference, candidate_mid, weights=(0.25, 0.25, 0.25, 0.25),
                   smoothing_function=smoothie)

print("\n=== n-gram 가중치 비교 (비슷한 번역 기준) ===")
print(f"1-gram만      : {w1:.4f}")
print(f"1~2-gram      : {w2:.4f}")
print(f"1~4-gram 균등 : {w4:.4f}")
